# ESPHome API Encryption Key
# This key is used for connecting to ESPHome devices that require Noise protocol encryption
# Get this key from your ESPHome device configuration (api: encryption: key in YAML)
# Format: base64-encoded 32-byte key
# 
# To use:
# 1. Copy this file to .env: cp .env.example .env
# 2. Add your key: ESPHOME_API_KEY=your_base64_key_here
# 3. Add your credentials: ESPHOME_USERNAME=your_username ESPHOME_PASSWORD=your_password
# 4. Add dashboard URL: ESPHOME_DASHBOARD_URL=https://your-dashboard.com/
# 5. .env is in .gitignore so it won't be committed

ESPHOME_API_KEY=
ESPHOME_USERNAME=
ESPHOME_PASSWORD=
ESPHOME_DASHBOARD_URL=
