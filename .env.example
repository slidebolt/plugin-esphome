# ESPHome Plugin Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# Native API encryption key (Noise protocol).
# Get this from your device YAML: api: encryption: key: <value>
# Format: base64-encoded 32-byte key. Leave blank for unencrypted devices.
ESPHOME_API_KEY=

# ESPHome Dashboard (optional — enables startup address seeding for all devices).
# When set, the plugin fetches current IP addresses from the dashboard before
# attempting mDNS discovery. This means devices that don't announce via mDNS
# (e.g. after a reboot) will still connect immediately.
#
# ESPHOME_DASHBOARD_URL  — base URL of your ESPHome dashboard
# ESPHOME_DASHBOARD_USER — dashboard login username
# ESPHOME_DASHBOARD_PASSWORD — dashboard login password
ESPHOME_DASHBOARD_URL=https://your-esphome-dashboard.example.com
ESPHOME_DASHBOARD_USER=yourusername
ESPHOME_DASHBOARD_PASSWORD=yourpassword

# Enable verbose trace logging (1 = on, 0 = off).
ESPHOME_TRACE=0
